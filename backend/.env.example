# Database URL (async driver for SQLAlchemy async engine)
# Alembic automatically converts asyncpg → psycopg for synchronous migrations.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sentinellog

# JWT Configuration
# IMPORTANT: Generate a strong random secret for production (>= 32 characters).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-generate-a-strong-random-secret
ALGORITHM=HS256
JWT_ISSUER=sentinellog-ai
JWT_AUDIENCE=sentinellog-ai

# Token expiration settings
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# Rate Limiting
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=3/minute
PASSWORD_RESET_RATE_LIMIT=3/minute

# Deprecated — kept for backward compatibility
AUTO_REFRESH_THRESHOLD_SECONDS=300

# Hugging Face API key
HF_TOKEN=
